#!/bin/sh
# Generated by hookyard build. Selects the bundled hookyard binary for this
# host; an unsupported host exits 0 with no output, which every engine reads
# as "no opinion" (fail-open, design doc §3.1).
case "$(uname -s)" in
Linux) os=linux ;;
Darwin) os=darwin ;;
*) exit 0 ;;
esac
case "$(uname -m)" in
x86_64 | amd64) arch=amd64 ;;
aarch64 | arm64) arch=arm64 ;;
*) exit 0 ;;
esac
bin="$(dirname "$0")/hookyard-$os-$arch"
[ -x "$bin" ] || exit 0
exec "$bin" "$@"
